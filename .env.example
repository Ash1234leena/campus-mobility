# =====================================================================
# ACIMS Campus Mobility — SMS Notification Environment Configuration
# =====================================================================

# Twilio Account SID (Found on Twilio Console dashboard: https://console.twilio.com)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Twilio Auth Token (Found on Twilio Console dashboard)
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Twilio Phone Number (Purchased/Allocated Twilio number in E.164 format, e.g. +1XXXXXXXXXX)
TWILIO_PHONE_NUMBER=+1234567890

# Optional Server Port (Default is 3500 for Campus Mobility)
PORT=3500
